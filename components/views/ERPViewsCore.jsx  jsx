    return (
      <div style={s.container}>
        <div style={s.header}>
          <h1 style={s.title}>💳 {t('credit', 'Credit Balances')}</h1>
        </div>
        <div style={s.statsGrid}>
          <div style={s.statCard}>
            <div style={s.statLabel}>Customers with Credit</div>
            <div style={s.statValue}>{withCredit.length}</div>
