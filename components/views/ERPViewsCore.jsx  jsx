            <tbody>
              {withCredit.map(c => (
                <tr key={c.id}>
                  <td style={{ ...s.td, fontWeight: '600' }}>{c.name}</td>
                  <td style={s.td}>{c.phone || '-'}</td>
                  <td style={{ ...s.tdRight, color: '#A78BFA', fontWeight: '700' }}>{fmt(c.store_credit)}</td>
                  <td style={s.tdRight}>{fmt(c.credit_limit)}</td>
