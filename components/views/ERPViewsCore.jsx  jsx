  // ═══════════════════════════════════════════════════════════════
  // CREDIT BALANCES
  // ═══════════════════════════════════════════════════════════════
  if (page === 'credit') {
    const withCredit = (data.customers || []).filter(c => (c.store_credit || 0) > 0);
